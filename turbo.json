{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/sdk/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["@simw/web#build", "@simw/demo-sites#build"],
      "cache": false,
      "passThroughEnv": ["BASE_URL", "CI", "NEXT_PUBLIC_EVENTS_URL", "PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
