{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/sdk/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["@simw/web#build:e2e", "@simw/demo-sites#build"],
      "cache": false,
      "passThroughEnv": ["BASE_URL", "CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "build:e2e": {
      "dependsOn": ["^build"],
      "outputs": [".next-e2e/**", "!.next-e2e/cache/**", "public/sdk/**"]
    }
  }
}
