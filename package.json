{
  "name": "seeitmyway",
  "private": true,
  "description": "The preference layer for the web. Websites that listen.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@simw/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome ci . && turbo run typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
