# Every value is optional; see src/lib/config.ts. NEXT_PUBLIC_* values are inlined at build time.

# Absolute origin of this site. Default: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel,
# otherwise http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://seeitmyway.vercel.app

# Where the SDK's script-tag build is served. Default: $NEXT_PUBLIC_SITE_URL/sdk/simw.global.js
# NEXT_PUBLIC_SDK_URL=

# Events Worker (apps/events). Unset: anonymous counting stays on this device.
# NEXT_PUBLIC_EVENTS_URL=https://simw-events.<account>.workers.dev

# Scanner Worker (apps/scanner). Unset: /listen keeps its "coming soon" state.
# NEXT_PUBLIC_SCANNER_URL=https://simw-scanner.<account>.workers.dev
