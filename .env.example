# Every environment variable SeeItMyWay uses, with where to find each value and where it goes.
# Names only: never put a real value in this file. It's committed; `.env` and `.env*.local` aren't.
#
# Nothing reads this file from the repo root. Keep secrets in a password manager and set them where
# each section says. Empty values count as unset everywhere.

# --- Vercel CLI deploys (docs/deploy/vercel.md, "Deploy from the CLI") -------------------------
# Not needed for Git deploys: pushes to `main` already deploy through Vercel's Git integration.
# Goes in: your shell, or the Claude Code cloud environment's settings, so a session can deploy.

# Account Settings → Tokens → Create Token. Scope it to the team and give it an expiry.
VERCEL_TOKEN=
# The team ID (`team_…`) from Team Settings → General. The CLI calls it the org ID, so a value
# collected as VERCEL_TEAM_ID goes here. Also `orgId` in `.vercel/project.json` after `vercel link`.
VERCEL_ORG_ID=
# Project → Settings → General → Project ID (`prj_…`). Also `projectId` in `.vercel/project.json`.
VERCEL_PROJECT_ID=

# --- Cloudflare Worker deploys (apps/events/README.md, apps/scanner/README.md) -----------------
# Goes in: your shell, or the Claude Code cloud environment's settings. wrangler reads them.

# My Profile → API Tokens → Create Token → Custom token, with Account permissions
# Workers Scripts: Edit, D1: Edit and Browser Rendering: Edit (the last one is for the scanner).
CLOUDFLARE_API_TOKEN=
# Shown by `pnpm exec wrangler whoami`, and on the dashboard's account home.
CLOUDFLARE_ACCOUNT_ID=

# --- Web app build (apps/web) ------------------------------------------------------------------
# All optional. Goes in: Vercel → Project → Settings → Environment Variables. They're inlined at
# build time, so redeploy after changing one. Locally: `apps/web/.env.local` (Next.js reads env
# files from apps/web, not the repo root). Vercel sets VERCEL_PROJECT_PRODUCTION_URL itself.

# Production only. Unset: https://$VERCEL_PROJECT_PRODUCTION_URL. Set it once a custom domain exists.
NEXT_PUBLIC_SITE_URL=
# Unset: the app serves /sdk/simw.global.js itself. Set it once the SDK is on a CDN.
NEXT_PUBLIC_SDK_URL=
# Production and Preview: https://simw-events.<account>.workers.dev. Unset: counting stays on the device.
NEXT_PUBLIC_EVENTS_URL=
# Production and Preview: https://simw-scanner.<account>.workers.dev. Unset: /listen shows "coming soon".
NEXT_PUBLIC_SCANNER_URL=
# 1 turns off Next.js's own build telemetry.
NEXT_TELEMETRY_DISABLED=

# --- Smoke test (docs/deploy/vercel.md, "Smoke test a deployment") -----------------------------
# Goes in: your shell, for one run: `BASE_URL=https://<project>.vercel.app pnpm test:e2e`.
# Unset: the browser tests start the app locally.
BASE_URL=

# Not environment variables: the Workers' ALLOWED_ORIGINS and PUBLIC_SITE_URL are passed to
# `wrangler deploy --var` (see each Worker's README), with local defaults in wrangler.jsonc.
